# Copy this to .env.local and fill in your values

# REQUIRED: Use at least 32 random characters in every environment
JWT_SECRET=replace-with-at-least-32-random-characters

# REQUIRED: Turso database connection
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: set the base URL for QR codes (defaults to request origin)
# NEXT_PUBLIC_BASE_URL=https://macfarlane.vercel.app

# ── Email (optional, Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=assets@example.edu.au

# Email address that receives admin notifications
ADMIN_EMAIL=shamikararavindu@gmail.com
