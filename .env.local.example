# Copy this to .env.local and fill in your values

# REQUIRED: Change this to a strong random string in production
JWT_SECRET=change-me-to-a-strong-random-secret

# Optional: set the base URL for QR codes (defaults to request origin)
# NEXT_PUBLIC_BASE_URL=https://macfarlane.vercel.app

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Create a Gmail account (e.g. mps.assets@gmail.com) or use an existing one.
# Then generate an App Password:
#   1. Go to myaccount.google.com → Security → 2-Step Verification (enable it)
#   2. Go to myaccount.google.com → Security → App Passwords
#   3. Create a new app password — copy the 16-character code
#
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email address that receives admin notifications (new requests, allocations, returns)
ADMIN_EMAIL=shamikararavindu@gmail.com
